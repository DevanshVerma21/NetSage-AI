# NetSage AI — environment template
# Copy to .env and fill in.  NEVER commit .env (it is gitignored).

# Which provider the AI layer uses.
#   gemini     = default live provider (free tier available)
#   mock       = deterministic offline provider, no key required
#   anthropic  = optional future provider (not wired by default)
LLM_PROVIDER=gemini

# Current stable Gemini Flash model (verified 2026-08-25).
# gemini-2.0-flash is SHUT DOWN - do not use.
LLM_MODEL=gemini-3.7-flash

# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional, unused unless LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=

# Paths (defaults are correct for a normal checkout)
DATA_DIR=data
PROMPTS_DIR=prompts
